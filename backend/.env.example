# PostgreSQL connection string. On Render, this is filled in automatically
# when the web service is linked to a Render Postgres database.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# The exact URL of the deployed frontend (Vercel), no trailing slash.
# Needed so the backend accepts cross-site cookies from it.
CLIENT_ORIGIN="https://your-site.vercel.app"

# Used only once, by `npm run seed`, to create/update the admin account.
ADMIN_EMAIL="admin@console.com"
ADMIN_PASSWORD="admin123"

NODE_ENV="production"
PORT="4000"
