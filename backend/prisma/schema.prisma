generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  avatarUrl    String?
  role         Role      @default(user)
  createdAt    DateTime  @default(now())
  comments     Comment[]
}

model Project {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String
  result      String?
  link        String?
  shot        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Single-row key/value store for editable site text: hero title,
// hero subtitle, about paragraphs, whatsapp number, contact email, etc.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  approved  Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
